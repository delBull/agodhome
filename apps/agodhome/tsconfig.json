{
  "extends": "tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "moduleResolution": "node",
    "paths": {
      "@/*": ["./src/*"],
      "@vercel/speed-insights/next": ["node_modules/@vercel/speed-insights/next/index"]
    },
     "types": ["react", "node", "mdx"]
  },
  "include": [
    "next-env.d.ts",
    "types",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "**/*.mdx",
    "middleware.ts",
    "next.config.mjs",
    "src/types"
  ],
  "exclude": ["node_modules"]
}
